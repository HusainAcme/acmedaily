# Copy this file to .env and fill in your key:
#
#   cp .env.example .env
#
# .env is gitignored and never committed. It is read automatically by
# `npm run feeds`, so the weekly summary works locally without re-entering
# the key each time.
#
# Get a key at https://platform.claude.com -> API keys.
# This is only needed for the weekly AI summary; everything else runs without it.

ANTHROPIC_API_KEY=sk-ant-...
